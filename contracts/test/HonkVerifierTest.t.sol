pragma solidity >=0.8.21;

import "forge-std/Test.sol";
import "../UltraHonkVerifier.sol";

/// @notice Feasibility probe: verify a real bb UltraHonk proof on-chain and measure gas.
/// Circuit: prove knowledge of x s.t. poseidon2_permutation([x,0,0,0])[0] == y (public)
/// x=1, y=0x02a04ea402711ced2d4bc39608cc5350a7db4af98ec2950d4d1ec30334d6c2b4
contract HonkVerifierTest is Test {
    HonkVerifier public verifier;

    function setUp() public {
        verifier = new HonkVerifier();
    }

    function test_verifyProof_succeeds() public view {
        // Public inputs (1 field element: y = poseidon2_perm([1,0,0,0])[0])
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = bytes32(0x02a04ea402711ced2d4bc39608cc5350a7db4af98ec2950d4d1ec30334d6c2b4);

        // Real proof bytes generated by `bb prove -t evm` (5312 bytes)
        bytes memory proof = hex"";

        uint256 gasBefore = gasleft();
        bool ok = verifier.verify(proof, publicInputs);
        uint256 gasUsed = gasBefore - gasleft();

        console2.log("verify() gas used:", gasUsed);
        assertTrue(ok, "Proof verification failed");
    }

    /// @dev Sanity: wrong public input must fail verification
    function test_verifyProof_wrongPublicInput_fails() public {
        bytes32[] memory badInputs = new bytes32[](1);
        badInputs[0] = bytes32(uint256(42));

        bytes memory proof = hex"";

        // This should revert because the public input does not match the committed value in the proof
        vm.expectRevert();
        verifier.verify(proof, badInputs);
    }
}
