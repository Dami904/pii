pragma solidity ^0.8.28;

import "forge-std/Test.sol";
import {WithdrawVerifier} from "../verifiers/WithdrawVerifier.sol";

interface IWithdrawVerifier {
    function verify(bytes calldata _proof, bytes32[] calldata _publicInputs) external view returns (bool);
}

/**
 * @title WithdrawVerifierTest
 * @notice Chunk 3+4 gate: the real UltraHonk proof (generated by bb) must verify;
 *         four tamper cases must be rejected.
 *
 * Fixture scenario (gen-withdraw-fixture.ts):
 *   2-leaf tree: dummy at index 0, 1000-USDC note at index 1.
 *   Withdraw 700 USDC, 300 USDC change.
 *   spending_key = 7, recipient = 0xdeadbeef...
 *
 * Public inputs order (SPEC §4.1):
 *   [0] merkle_root
 *   [1] nullifier
 *   [2] recipient
 *   [3] amount (700)
 *   [4] change_commitment
 *   [5] ext_data_hash
 */
contract WithdrawVerifierTest is Test {
    WithdrawVerifier internal verifier;

    bytes   internal proof;
    bytes32[] internal pubInputs; // 6 × bytes32

    // Path prefix for fixture files (relative to foundry.toml / project root)
    string constant PROOF_PATH    = "contracts/test/fixtures/withdraw_proof.bin";
    string constant PI_PATH       = "contracts/test/fixtures/withdraw_public_inputs.bin";

    function setUp() public {
        verifier = new WithdrawVerifier();

        // Load proof bytes
        proof = vm.readFileBinary(PROOF_PATH);

        // Load public inputs as 32-byte chunks
        bytes memory piRaw = vm.readFileBinary(PI_PATH);
        // piRaw is 6 × 32 = 192 bytes
        require(piRaw.length == 192, "unexpected public inputs size");
        pubInputs = new bytes32[](6);
        for (uint256 i = 0; i < 6; i++) {
            bytes32 chunk;
            assembly {
                chunk := mload(add(add(piRaw, 32), mul(i, 32)))
            }
            pubInputs[i] = chunk;
        }
    }

    // ── Happy path ────────────────────────────────────────────────────────────

    function test_verify_real_proof() public {
        uint256 gasBefore = gasleft();
        bool ok = verifier.verify(proof, pubInputs);
        uint256 gasUsed = gasBefore - gasleft();
        console.log("verify() gas:", gasUsed);
        assertTrue(ok, "proof should verify");
    }

    // ── Tamper cases — all must revert or return false ─────────────────────────

    /// Tamper 1: redirect recipient to a different address
    function test_tamper_redirected_recipient() public {
        bytes32[] memory badInputs = _copyPubInputs();
        // pubInputs[2] = recipient; replace with a different address (field value, not address literal)
        badInputs[2] = bytes32(uint256(1234567890));
        // Expect either a revert or a false return
        (bool success, bytes memory data) = address(verifier).staticcall(
            abi.encodeCall(IWithdrawVerifier.verify, (proof, badInputs))
        );
        // Either revert (success=false) or explicit false
        if (success) {
            bool result = abi.decode(data, (bool));
            assertFalse(result, "tampered recipient must not verify");
        }
        // if it reverted, that is also a valid rejection
    }

    /// Tamper 2: inflate amount (claim to withdraw more than deposited)
    function test_tamper_inflated_amount() public {
        bytes32[] memory badInputs = _copyPubInputs();
        // pubInputs[3] = amount; change 700 → 9999999
        badInputs[3] = bytes32(uint256(9_999_999));
        (bool success, bytes memory data) = address(verifier).staticcall(
            abi.encodeCall(IWithdrawVerifier.verify, (proof, badInputs))
        );
        if (success) {
            bool result = abi.decode(data, (bool));
            assertFalse(result, "inflated amount must not verify");
        }
    }

    /// Tamper 3: swap ext_data_hash (relay to a different pool/chain)
    function test_tamper_wrong_ext_data_hash() public {
        bytes32[] memory badInputs = _copyPubInputs();
        // pubInputs[5] = ext_data_hash; flip to all-ones
        badInputs[5] = bytes32(type(uint256).max);
        (bool success, bytes memory data) = address(verifier).staticcall(
            abi.encodeCall(IWithdrawVerifier.verify, (proof, badInputs))
        );
        if (success) {
            bool result = abi.decode(data, (bool));
            assertFalse(result, "wrong ext_data_hash must not verify");
        }
    }

    /// Tamper 4: flip one byte in the proof
    function test_tamper_flipped_proof_byte() public {
        bytes memory badProof = _copyProof();
        // Flip byte at position 100
        badProof[100] = bytes1(uint8(badProof[100]) ^ 0xFF);
        (bool success, bytes memory data) = address(verifier).staticcall(
            abi.encodeCall(IWithdrawVerifier.verify, (badProof, pubInputs))
        );
        if (success) {
            bool result = abi.decode(data, (bool));
            assertFalse(result, "flipped proof byte must not verify");
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    function _copyPubInputs() internal view returns (bytes32[] memory) {
        bytes32[] memory copy = new bytes32[](pubInputs.length);
        for (uint256 i = 0; i < pubInputs.length; i++) {
            copy[i] = pubInputs[i];
        }
        return copy;
    }

    function _copyProof() internal view returns (bytes memory) {
        bytes memory copy = new bytes(proof.length);
        for (uint256 i = 0; i < proof.length; i++) {
            copy[i] = proof[i];
        }
        return copy;
    }
}
