pragma solidity ^0.8.28;

import "forge-std/Test.sol";
import {PiiPool}          from "../src/PiiPool.sol";
import {LibPiiHash}       from "../src/LibPiiHash.sol";
import {WithdrawVerifier} from "../verifiers/WithdrawVerifier.sol";
import {TransferVerifier} from "../verifiers/TransferVerifier.sol";

/**
 * @title SdkProofTest
 * @notice Verifies proofs generated by sdk/scripts/sdk-prove-e2e.ts
 *         (noir_js + bb.js, verifierTarget:"evm") against the compiled
 *         Solidity verifiers, then runs the full E2E pool flow.
 *
 * Prerequisites:
 *   bun sdk/scripts/sdk-prove-e2e.ts
 * This writes sdk_transfer_proof.bin, sdk_transfer_public_inputs.bin,
 *              sdk_withdraw_proof.bin,  sdk_withdraw_public_inputs.bin
 * into contracts/test/fixtures/.
 */

// Reuse the minimal MockERC20 definition (avoid importing from another test file)
contract MockERC20Sdk {
    mapping(address => uint256) public balanceOf;
    mapping(address => mapping(address => uint256)) public allowance;
    function mint(address to, uint256 amount) external { balanceOf[to] += amount; }
    function approve(address spender, uint256 amount) external returns (bool) {
        allowance[msg.sender][spender] = amount; return true;
    }
    function transfer(address to, uint256 amount) external returns (bool) {
        require(balanceOf[msg.sender] >= amount, "insufficient");
        balanceOf[msg.sender] -= amount; balanceOf[to] += amount; return true;
    }
    function transferFrom(address from, address to, uint256 amount) external returns (bool) {
        require(balanceOf[from] >= amount, "insufficient");
        require(allowance[from][msg.sender] >= amount, "allowance");
        allowance[from][msg.sender] -= amount;
        balanceOf[from] -= amount; balanceOf[to] += amount; return true;
    }
}

contract SdkProofTest is Test {
    // ── Addresses ────────────────────────────────────────────────────────────
    address constant USDC_ADDR = 0x3600000000000000000000000000000000000000;
    address constant POOL_ADDR = 0x0000000000000000000000000000000000001001;
    address constant OWNER     = address(0xABCD);
    address constant ALICE     = address(0xA11CE);
    address constant RELAYER   = address(0x000000000000000000000000000000000000FEE0);
    address constant RECIPIENT = address(0x000000000000000000000000000000000000bEEF);

    // ── Golden values (same as PiiPoolE2E) ───────────────────────────────────
    uint256 constant USDC_ID   = 0x07db0ab36b82e923f962dc97079a2321c10234f3faf2b14672413ffd3838d86e;
    uint256 constant CMT_A0    = 0x25401d063ca1ea2e93b060c3191f5221a54f9d52fd5e8f81e666d9d07d6aa812;
    uint256 constant CMT_A1    = 0x291c073c82e06e7981a792ed4a700d1ab55853111cb1f4c20b5a69e67fdc7c86;
    uint256 constant CMT_FEE   = 0x02589e958e1914010710d07839b95cda441ab5381b267cff8e5395f87eb2ca3d;
    uint256 constant ROOT_3    = 0x0e14666af22b282d457244bb3c6c825c2872c37748e30b120b74e9ed9b8364a2;
    uint256 constant NF0       = 0x02b1971abd74524aa9b7175b7689356d5268d4c7bbcd59c57594577e7ca28bf4;
    uint256 constant NF1       = 0x21774fd5719064deb939a8266e597e385ea6a44be87f56350c00aafff704b637;
    uint256 constant NF_FEE    = 0x1c6f8abd5bf2305b5a1925ef08dd290b042773f1c56ba2a85fe8350a40f74008;
    uint256 constant OUT_RECIP = 0x10c7132167488662b478551f5621750b5ac7154ae9d962a266dbede7681bc072;
    uint256 constant OUT_CHG   = 0x027bfe3dad0b995d2a93ddb4349d4f4dd6c7ad4a6552d6ae5f9e694c6608cf3d;
    uint256 constant OUT_FEE   = 0x27b49af6c3e50a44e47b74084da2b11939c3e2cf751340f282d50ceb40fa3a7f;
    uint256 constant OUT_FEE_CHG = 0x1e44673056bf3404c2bd09d3ef8fc25ea094d13da085dd4a5705b8359a592370;
    uint256 constant ROOT_AFTER_TRANSFER = 0x2e4650c96ea6622aa0a9bc0637936d5a096e9fb4193010c3d852e7861ce617bb;
    uint256 constant NFB       = 0x0d9ae79f04939e9a77ca1d0bde172b9f21e71ac5a780214b1d542861f4d4a2a0;
    uint256 constant OK_RELAYER = 0x06cb4824a064e10e1c65bba82631507dfc6883287fa218a918ab9454eba930cb;
    uint256 constant TRANSFER_FEE = 50_000;
    uint256 constant EMPTY_ROOT   = 0x19ee29beb37701dd87b245c58cc348522c86f063f3aa049d19d6fddc71de23c7;
    uint256 constant EXT_TRANSFER = 0x1429fb99b3c64eacf6b125ab577d0c351682cd93bfb794a89934bb67c950e74a;
    uint256 constant EXT_WITHDRAW = 0x2dcf4e1f932b2eeed8dd729c9e20b11fec4f5090aead1c46bcb9249c4b3e7403;
    uint256 constant ZERO_VALUE   = 0x10aa41cd532efb9f2b7337c3f588d65e4af1b6c5bc76a7faa5db259c06ec2466;

    // ── Contracts ────────────────────────────────────────────────────────────
    MockERC20Sdk     usdc;
    WithdrawVerifier wVerifier;
    TransferVerifier tVerifier;
    PiiPool          pool;

    // ── SDK-generated proofs (loaded in setUp) ───────────────────────────────
    bytes     sdkTransferProof;
    bytes32[] sdkTransferPub;   // 12 fields
    bytes     sdkWithdrawProof;
    bytes32[] sdkWithdrawPub;   // 6 fields

    // ── deposit secrets (computed in setUp) ──────────────────────────────────
    uint256 secA0;
    uint256 secA1;
    uint256 secFee;

    function setUp() public {
        wVerifier = new WithdrawVerifier();
        tVerifier = new TransferVerifier();

        MockERC20Sdk impl = new MockERC20Sdk();
        vm.etch(USDC_ADDR, address(impl).code);
        usdc = MockERC20Sdk(USDC_ADDR);

        deployCodeTo(
            "PiiPool.sol:PiiPool",
            abi.encode(
                USDC_ADDR,
                address(wVerifier),
                address(tVerifier),
                OWNER,
                uint256(10_000_000),
                uint256(50_000_000)
            ),
            POOL_ADDR
        );
        pool = PiiPool(POOL_ADDR);

        // Deposit secrets
        uint256 okA = LibPiiHash.hash2(7, 0);
        secA0  = LibPiiHash.hash2(okA, 11);
        secA1  = LibPiiHash.hash2(okA, 12);
        secFee = LibPiiHash.hash2(okA, 13);

        // Load SDK-generated transfer proof (12 public inputs = 384 bytes)
        sdkTransferProof = vm.readFileBinary("contracts/test/fixtures/sdk_transfer_proof.bin");
        {
            bytes memory raw = vm.readFileBinary("contracts/test/fixtures/sdk_transfer_public_inputs.bin");
            sdkTransferPub = new bytes32[](12);
            for (uint256 i = 0; i < 12; i++) {
                bytes32 w;
                assembly { w := mload(add(add(raw, 0x20), mul(i, 0x20))) }
                sdkTransferPub[i] = w;
            }
        }

        // Load SDK-generated withdraw proof (6 public inputs = 192 bytes)
        sdkWithdrawProof = vm.readFileBinary("contracts/test/fixtures/sdk_withdraw_proof.bin");
        {
            bytes memory raw = vm.readFileBinary("contracts/test/fixtures/sdk_withdraw_public_inputs.bin");
            sdkWithdrawPub = new bytes32[](6);
            for (uint256 i = 0; i < 6; i++) {
                bytes32 w;
                assembly { w := mload(add(add(raw, 0x20), mul(i, 0x20))) }
                sdkWithdrawPub[i] = w;
            }
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────────────────

    function _dummyMemo() internal pure returns (bytes memory) { return new bytes(134); }

    function _deposit3() internal {
        uint256[3] memory amounts = [uint256(2_000_000), 1_000_000, 200_000];
        uint256[3] memory secrets = [secA0, secA1, secFee];
        for (uint256 i = 0; i < 3; i++) {
            usdc.mint(ALICE, amounts[i]);
            vm.prank(ALICE); usdc.approve(POOL_ADDR, amounts[i]);
            vm.prank(ALICE); pool.deposit(amounts[i], secrets[i], _dummyMemo());
        }
        assertEq(pool.currentRoot(), ROOT_3, "root after 3 deposits");
    }

    function _transferArgs() internal pure returns (PiiPool.TransferArgs memory) {
        return PiiPool.TransferArgs({
            root:            ROOT_3,
            nf0:             NF0,
            nf1:             NF1,
            nfFee:           NF_FEE,
            outRecipient:    OUT_RECIP,
            outChange:       OUT_CHG,
            outFee:          OUT_FEE,
            outFeeChange:    OUT_FEE_CHG,
            eligibilityRoot: EMPTY_ROOT,
            fee:             TRANSFER_FEE,
            relayerOwnerKey: OK_RELAYER
        });
    }

    function _transferMemos() internal pure returns (bytes[] memory) {
        bytes[] memory m = new bytes[](4);
        m[0] = hex"027b46982a0f4d7b17872ef331ff1587ed55c4034f8fe724b8ad7223372e196710d368b150ae85fed3ac2890f5830644ba04b13a2ec7ed37a89ea6db281f45b39003849e99b7dc0cba52f088592c1727e056213cdb90442d5708ab84c26e57703547d60275045fc16e7aa96a899b22d653d304a9befa1dccbf33205358b50a44130bed789091";
        m[1] = hex"02c067a6e6418ad69e2d0f997cd2f537d3f1a3bdab11064898fff8a9fb8ae6a59617739b27186a2ed52bd1281220fe8ff145dc56658538f5250dee5675011585aa8f4e92c3ec448c756cdfd3a0e7261427ca64f516741a1e0148b426afcbc682770796061071670aee699c0248ff2e9d63f0865b7006e63806d52620a03fc35e497d6c75d4bb";
        m[2] = hex"02fcf02750a860e9a9b6acbbfbbcb72020655602ad7c215ad160c405dc6e010f7b7a8b246232a689ecd672d08dbe0199f311832fd49c0600290e4871b049abbe9acab5d662e103e762703615d35cf5f67d08695d9155a48bf63d0a575c9d8cdf9607a8c4d16babc733f8989063b75cad0babc0e8b0eaa40fba7530ffeeb3b8c49df9ad73692b";
        m[3] = hex"020c83a2940a915db7cfd1973cc9cb5a62e67c30a2347a97b18c180098c8e58cc6b3d602c451cabddd93227ee38711961a23d2e657a13af45f297128d782c6795203b531126918bf122abdacadd3f7d48944804c53cc9333f309492613f9eed43fe8e9caf2413f941f1379f281098a1c68086a44d7d0cbd7ad1d7724ef6adf1a90865783bc6c";
        return m;
    }

    function _withdrawMemos() internal pure returns (bytes[] memory) {
        bytes[] memory m = new bytes[](1);
        m[0] = hex"03238f74b327235cba1c623cb2c0606c1828470d4ebde3f18a871dfa5d708cf2c78bf6e0d8369e23ecbd3883c7d87886081127d9dff31b9c487b03288bc401e6116a66d4464f7ccbe5d6056b0925d03edd0d8e5c0989f16862c9e89b1c0f030351bb284ab441065da748c0e6392015f03e1bdbdd9c17725791fa1bc29f15fbc1cdb6e81a1eac";
        return m;
    }

    function _doTransfer() internal {
        pool.transfer(sdkTransferProof, _transferArgs(), RELAYER, _transferMemos());
    }

    function _doWithdraw() internal {
        pool.withdraw(sdkWithdrawProof, ROOT_AFTER_TRANSFER, NFB, RECIPIENT, 2_500_000, ZERO_VALUE, address(0), 0, _withdrawMemos());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // (a) SDK transfer proof verifies on TransferVerifier
    // ─────────────────────────────────────────────────────────────────────────

    function test_sdk_transfer_proof_verifies() public view {
        bool ok = tVerifier.verify(sdkTransferProof, sdkTransferPub);
        assertTrue(ok, "SDK transfer proof did not verify");
    }

    // ─────────────────────────────────────────────────────────────────────────
    // (b) SDK withdraw proof verifies on WithdrawVerifier
    // ─────────────────────────────────────────────────────────────────────────

    function test_sdk_withdraw_proof_verifies() public view {
        bool ok = wVerifier.verify(sdkWithdrawProof, sdkWithdrawPub);
        assertTrue(ok, "SDK withdraw proof did not verify");
    }

    // ─────────────────────────────────────────────────────────────────────────
    // (c) Public inputs match the golden fixture values
    // ─────────────────────────────────────────────────────────────────────────

    function test_sdk_transfer_public_inputs_match_golden() public view {
        // [0] merkle_root
        assertEq(uint256(sdkTransferPub[0]),  ROOT_3,           "root");
        // [1] nf_0
        assertEq(uint256(sdkTransferPub[1]),  NF0,              "nf0");
        // [2] nf_1
        assertEq(uint256(sdkTransferPub[2]),  NF1,              "nf1");
        // [3] nf_fee
        assertEq(uint256(sdkTransferPub[3]),  NF_FEE,           "nf_fee");
        // [4] out_recipient
        assertEq(uint256(sdkTransferPub[4]),  OUT_RECIP,        "out_recip");
        // [5] out_change  (not a named constant in this test; skip exact check)
        // [6] out_fee
        assertEq(uint256(sdkTransferPub[6]),  OUT_FEE,          "out_fee");
        // [7] out_fee_change
        assertEq(uint256(sdkTransferPub[7]),  OUT_FEE_CHG,      "out_fee_chg");
        // [8] eligibility_root
        assertEq(uint256(sdkTransferPub[8]),  EMPTY_ROOT,       "elig_root");
        // [9] fee
        assertEq(uint256(sdkTransferPub[9]),  TRANSFER_FEE,     "fee");
        // [10] relayer_owner_key
        assertEq(uint256(sdkTransferPub[10]), OK_RELAYER,       "relayer_ok");
        // [11] ext_data_hash
        assertEq(uint256(sdkTransferPub[11]), EXT_TRANSFER,     "ext_hash");
    }

    function test_sdk_withdraw_public_inputs_match_golden() public view {
        // [0] merkle_root
        assertEq(uint256(sdkWithdrawPub[0]), ROOT_AFTER_TRANSFER, "root");
        // [1] nullifier
        assertEq(uint256(sdkWithdrawPub[1]), NFB,                 "nfB");
        // [2] recipient
        assertEq(uint256(sdkWithdrawPub[2]), uint256(uint160(RECIPIENT)), "recipient");
        // [3] amount
        assertEq(uint256(sdkWithdrawPub[3]), 2_500_000,           "amount");
        // [4] change_commitment (ZERO_VALUE, no change)
        assertEq(uint256(sdkWithdrawPub[4]), ZERO_VALUE,          "change_cmt");
        // [5] ext_data_hash
        assertEq(uint256(sdkWithdrawPub[5]), EXT_WITHDRAW,        "ext_hash");
    }

    // ─────────────────────────────────────────────────────────────────────────
    // (d) Full E2E flow: deposit × 3, SDK transfer, SDK withdraw
    // ─────────────────────────────────────────────────────────────────────────

    function test_sdk_full_e2e_flow() public {
        _deposit3();
        assertEq(usdc.balanceOf(POOL_ADDR), 3_200_000, "pool balance after deposits");

        // Transfer
        uint256 gasBefore = gasleft();
        _doTransfer();
        uint256 gasTransfer = gasBefore - gasleft();
        emit log_named_uint("SDK transfer() gas", gasTransfer);

        assertEq(pool.currentRoot(), ROOT_AFTER_TRANSFER, "root after transfer");
        assertTrue(pool.nullifierSpent(NF0),    "nf0 spent");
        assertTrue(pool.nullifierSpent(NF1),    "nf1 spent");
        assertTrue(pool.nullifierSpent(NF_FEE), "nfFee spent");

        // Withdraw
        gasBefore = gasleft();
        _doWithdraw();
        uint256 gasWithdraw = gasBefore - gasleft();
        emit log_named_uint("SDK withdraw() gas", gasWithdraw);

        assertEq(usdc.balanceOf(RECIPIENT), 2_500_000, "bEEF balance");
        assertEq(usdc.balanceOf(POOL_ADDR),   700_000, "pool balance after withdraw");
        assertTrue(pool.nullifierSpent(NFB), "nfB spent");
    }
}
