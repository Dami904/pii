# Relayer configuration — copy to .env and fill in real values. NEVER commit .env.

# Required: EOA private key (hex, 0x-prefixed) used to submit transactions.
RELAYER_PRIVATE_KEY=0x<your_private_key>

# Required: Poseidon-derived spending key (bigint as hex) used to receive fee notes.
RELAYER_SPENDING_KEY=0x<your_spending_key_bigint>

# Pool contract address
# Arc Testnet: 0x75bc90aa025caeedde588295d42b8f19a8e4bff3
POOL_ADDRESS=0x<pool_address>

# RPC endpoint
# Arc Testnet: https://rpc.testnet.arc.io
RPC_URL=http://127.0.0.1:8545

# Chain ID (31337 = anvil/local, 5042002 = Arc Testnet)
CHAIN_ID=31337

# Minimum fee (USDC base units)
MIN_FEE=1000

# Server port
PORT=3001

# Max requests per IP per minute
RATE_LIMIT_RPM=10
